#!/bin/sh
#
# Start/stop crond (cron daemon)
# Custom version that handles BusyBox symlinks correctly
#

DAEMON="crond"
PIDFILE="/var/run/$DAEMON.pid"
DAEMON_PATH="/usr/sbin/$DAEMON"

CROND_ARGS=""

[ -r "/etc/default/$DAEMON" ] && . "/etc/default/$DAEMON"

# BusyBox' crond does not create a pidfile, so pass "-f" on the crond
# command line and use "--make-pidfile" to instruct start-stop-daemon
# to create one.
start() {
    printf 'Starting %s: ' "$DAEMON"

    # Create spool directory if it doesn't exist
    mkdir -p /var/spool/cron/crontabs

    start-stop-daemon --start --background --make-pidfile \
        --pidfile "$PIDFILE" --exec "$DAEMON_PATH" \
        -- -f $CROND_ARGS
    status=$?
    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi
    return "$status"
}

stop() {
    printf 'Stopping %s: ' "$DAEMON"

    # For BusyBox, use pidfile-based stop instead of --exec matching
    # This avoids the "no crond found" issue with busybox symlinks
    if [ -f "$PIDFILE" ]; then
        start-stop-daemon --stop --pidfile "$PIDFILE"
        status=$?
    else
        # Fallback: try to kill by name
        killall -q "$DAEMON" 2>/dev/null
        status=$?
    fi

    if [ "$status" -eq 0 ]; then
        echo "OK"
    else
        echo "FAIL"
    fi

    rm -f "$PIDFILE"
    return "$status"
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|reload}"
        exit 1
esac
