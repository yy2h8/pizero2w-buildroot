# Core optimizations
CONFIG_LOCALVERSION="-minimal"
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_LZ4=y
CONFIG_OPTIMIZE_INLINING=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y

# ARM specific
CONFIG_ARCH_BCM2835=y
CONFIG_ARM_THUMB=y
CONFIG_AEABI=y
CONFIG_VFPv3=y
CONFIG_NEON=y
CONFIG_ARM_ARCH_TIMER=y

# Memory
CONFIG_SLUB_TINY=y
CONFIG_EMBEDDED=y
CONFIG_EXPERT=y
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_MEMCG=n
CONFIG_PAGE_COUNTER=n

# Disable unnecessary subsystems
CONFIG_SOUND=n
CONFIG_SND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_VGA_CONSOLE=n
CONFIG_FRAMEBUFFER_CONSOLE=n
CONFIG_USB_GADGET=n
CONFIG_USB_HID=n
CONFIG_HID=n
CONFIG_INPUT_KEYBOARD=n
CONFIG_INPUT_MOUSE=n
CONFIG_SERIO=n
CONFIG_VT=n
CONFIG_LEGACY_PTYS=n
CONFIG_STAGING=n
CONFIG_CHROME_PLATFORMS=n
CONFIG_MEDIA_SUPPORT=n

# Keep PRINTK for development
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_KALLSYMS=n
CONFIG_FTRACE=n
CONFIG_DEBUG_FS=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n

# Network - WiFi only
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_MAC80211_HWSIM=n
# Build brcmfmac as module to avoid firmware loading race condition
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PCIE=n
# Firmware loading configuration
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=n
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=n
CONFIG_FW_LOADER_COMPRESS=n
CONFIG_PREVENT_FIRMWARE_BUILD=y
CONFIG_NETFILTER=n
CONFIG_IP_MULTICAST=n
CONFIG_IPV6=n
CONFIG_BRIDGE=n

# Disable unnecessary network interfaces/protocols (reduces boot bloat)
# These create dozens of unused interfaces like bond0, dummy0, tunl0, gre0, etc.
CONFIG_BONDING=n
CONFIG_DUMMY=n
CONFIG_IFB=n
CONFIG_NET_TEAM=n
CONFIG_TUN=n
CONFIG_VETH=n
CONFIG_NET_VRF=n

# Disable tunneling protocols
CONFIG_NET_IPGRE_DEMUX=n
CONFIG_NET_IPGRE=n
CONFIG_NET_IPGRE_BROADCAST=n
CONFIG_IP_GRE=n
CONFIG_NET_IPVTI=n
CONFIG_NET_FOU=n
CONFIG_GENEVE=n
CONFIG_VXLAN=n

# Disable amateur radio / AX.25 (creates yam*, bcsf*, bcsh*, nr*, rose*, bpq* interfaces)
CONFIG_HAMRADIO=n
CONFIG_AX25=n
CONFIG_NETROM=n
CONFIG_ROSE=n

# Disable other unused network features
CONFIG_EQUALIZER=n
CONFIG_NET_SCH_TEQL=n
CONFIG_ATM=n
CONFIG_L2TP=n
CONFIG_DECNET=n
CONFIG_LLC=n
CONFIG_ATALK=n
CONFIG_X25=n
CONFIG_LAPB=n
CONFIG_PHONET=n
CONFIG_IEEE802154=n
CONFIG_6LOWPAN=n
CONFIG_MAC802154=n
CONFIG_NET_SCHED=n
CONFIG_CAN=n
CONFIG_BT=n
CONFIG_NFC=n

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_NFS_FS=n
CONFIG_NFSD=n
CONFIG_FUSE_FS=n
CONFIG_ISO9660_FS=n
CONFIG_UDF_FS=n
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y

# Crypto for WiFi
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# SD/MMC
CONFIG_MMC=y
# WiFi SDIO fix: Disable the mmc-bcm2835 driver as it fails to initialize WiFi SDIO
# The sdhost-bcm2835 (CONFIG_MMC_BCM2835) works for SD card
# The sdhci-iproc (CONFIG_MMC_SDHCI*) should be used for WiFi SDIO
CONFIG_MMC_BCM2835=y
CONFIG_MMC_BCM2835_MMC=n
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_IPROC=y

# Serial console
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y

# Minimal power management (required for WiFi)
CONFIG_PM=y
CONFIG_PM_SLEEP=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n
CONFIG_PM_RUNTIME=y
CONFIG_PM_DEVFREQ=n

# Boot optimization
CONFIG_BLK_DEV_INITRD=n
# Enable kernel modules ONLY for WiFi driver (to fix firmware loading race)
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SRCVERSION_ALL=n
CONFIG_MODULE_SIG=n
CONFIG_MODULE_COMPRESS_NONE=y
CONFIG_TRIM_UNUSED_KSYMS=y
